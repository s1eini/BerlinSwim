# Copy to fastlane/.env (ignored by git) and fill in.
# App Store Connect → Users and Access → Integrations → App Store Connect API (role: App Manager)
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Path to the downloaded .p8 file – keep it outside the repo
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
# App Review contact phone (with country code, e.g. +49 30 1234567). Not stored in git.
# Leave empty to skip the review contact.
ASC_REVIEW_PHONE=
