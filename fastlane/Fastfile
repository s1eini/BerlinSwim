# Store texts and TestFlight notes for Berlin Swim.
#
#   fastlane preview            – show what `metadata` would upload (HTML preview, asks before uploading)
#   fastlane metadata           – upload texts, URLs, categories to the version in "Prepare for Submission"
#   fastlane testflight_notes   – set "What to Test" (de/en) on the current build
#
# Never uploads a binary or screenshots and never submits for review.
# API key settings come from fastlane/.env (not in git), see fastlane/.env.example.

default_platform(:ios)

# Absolute paths: fastlane runs actions from the repo root, so relative paths would break.
ROOT = File.expand_path("..", __dir__)
METADATA = File.join(ROOT, "fastlane/metadata")
TESTFLIGHT_NOTES = File.join(ROOT, "fastlane/testflight")
REVIEW = File.join(ROOT, "fastlane/review")
PROJECT_YML = File.read(File.join(ROOT, "ios/project.yml"))
VERSION = PROJECT_YML[/MARKETING_VERSION: "([^"]+)"/, 1]
BUILD   = PROJECT_YML[/CURRENT_PROJECT_VERSION: "([^"]+)"/, 1]

# App Review contact: name/email/notes from fastlane/review, phone only from fastlane/.env (not public).
# Without ASC_REVIEW_PHONE the review contact is left untouched.
def review_information
  phone = ENV["ASC_REVIEW_PHONE"].to_s.strip
  return nil if phone.empty?
  read = ->(name) { File.read(File.join(REVIEW, name)).strip }
  {
    first_name: read.call("first_name.txt"),
    last_name: read.call("last_name.txt"),
    email_address: read.call("email_address.txt"),
    phone_number: phone,
    notes: read.call("notes.txt")
  }
end

def upload_metadata(confirm:)
  options = {
    app_version: VERSION,
    metadata_path: METADATA,
    skip_binary_upload: true,
    skip_screenshots: true,
    submit_for_review: false,
    automatic_release: false,
    run_precheck_before_submit: false,
    force: !confirm # false = show HTML preview and ask before uploading
  }
  info = review_information
  options[:app_review_information] = info if info
  deliver(**options)
end

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
  end

  desc "Preview the store texts for #{VERSION}, upload only after confirmation"
  lane :preview do
    upload_metadata(confirm: true)
  end

  desc "Upload store texts, URLs and categories for #{VERSION} (no binary, no screenshots, no submission)"
  lane :metadata do
    upload_metadata(confirm: false)
  end

  desc "Read-only: latest builds with processing/beta review state, and beta test information"
  lane :beta_status do
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-uploadedDate", limit: 5,
      includes: "buildBetaDetail,betaAppReviewSubmission,preReleaseVersion"
    )
    rows = builds.first(5).map do |b|
      [
        "#{b.app_version} (#{b.version})",
        b.uploaded_date.to_s[0, 16],
        b.processing_state,
        b.build_beta_detail&.internal_build_state,
        b.build_beta_detail&.external_build_state,
        b.beta_app_review_submission&.beta_review_state || "–"
      ]
    end
    puts Terminal::Table.new(
      title: "Builds", rows: rows,
      headings: ["Version (Build)", "Uploaded", "Processing", "Internal", "External", "Beta review"]
    )

    detail = Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }).to_models.first
    UI.message("Beta review contact: #{[detail&.contact_first_name, detail&.contact_last_name].compact.join(' ').then { |n| n.empty? ? 'MISSING' : n }}, " \
               "email #{detail&.contact_email || 'MISSING'}, phone #{detail&.contact_phone.to_s.empty? ? 'MISSING' : 'set'}")
    Spaceship::ConnectAPI.get_beta_app_localizations(filter: { app: app.id }).to_models.each do |loc|
      UI.message("Test info #{loc.locale}: description #{loc.description.to_s.empty? ? 'MISSING' : 'set'}, " \
                 "feedback email #{loc.feedback_email || 'MISSING'}, privacy #{loc.privacy_policy_url || 'MISSING'}")
      UI.message("  description: #{loc.description}") unless loc.description.to_s.empty?
    end
  end

  desc "Set TestFlight test information (beta description, feedback email, privacy URL) for de-DE and en-GB"
  lane :beta_info do
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    existing = Spaceship::ConnectAPI.get_beta_app_localizations(filter: { app: app.id }).to_models
    privacy = File.read(File.join(METADATA, "de-DE", "privacy_url.txt")).strip
    feedback = File.read(File.join(REVIEW, "email_address.txt")).strip
    %w[de-DE en-GB].each do |locale|
      attrs = {
        description: File.read(File.join(TESTFLIGHT_NOTES, "beta_description", "#{locale}.txt")).strip,
        feedbackEmail: feedback,
        privacyPolicyUrl: privacy
      }
      if (loc = existing.find { |l| l.locale == locale })
        Spaceship::ConnectAPI.patch_beta_app_localizations(localization_id: loc.id, attributes: attrs)
        UI.success("Updated test information #{locale}")
      else
        Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: attrs.merge(locale: locale))
        UI.success("Created test information #{locale}")
      end
    end
  end

  desc "Set 'What to Test' (de/en) on build #{BUILD} of #{VERSION}"
  lane :testflight_notes do
    notes = ->(lang) { File.read(File.join(TESTFLIGHT_NOTES, "#{lang}.txt")).strip }
    upload_to_testflight(
      distribute_only: true,
      app_platform: "ios",
      app_version: VERSION,
      build_number: BUILD,
      localized_build_info: {
        "de-DE" => { whats_new: notes.call("de-DE") },
        "en-GB" => { whats_new: notes.call("en-GB") }
      },
      notify_external_testers: false
      # no skip_waiting_for_build_processing: with it, fastlane silently skips setting notes/distributing
    )
  end

  desc "Give build #{BUILD} of #{VERSION} to the TestFlight group 'external' (submits for beta review if needed)"
  lane :external do
    notes = ->(lang) { File.read(File.join(TESTFLIGHT_NOTES, "#{lang}.txt")).strip }
    upload_to_testflight(
      distribute_only: true,
      app_platform: "ios",
      app_version: VERSION,
      build_number: BUILD,
      distribute_external: true,
      groups: ["external"],
      notify_external_testers: true,
      localized_build_info: {
        "de-DE" => { whats_new: notes.call("de-DE") },
        "en-GB" => { whats_new: notes.call("en-GB") }
      }
    )
  end
end
